# Context exclusions for tools that support .agentignore.
# Keep package-lock.json, project settings, docs, rules, scripts, and shipped
# workout JSON files available for targeted inspection.

# Dependencies and caches
node_modules/
.pnpm-store/
.yarn/
.cache/
.vite/

# Generated build output
dist/
build/
out/
*.tsbuildinfo

# Version-control internals
.git/

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/
credentials.json

# Logs and verification output
*.log
coverage/
.nyc_output/
test-results/
playwright-report/

# OS and temporary editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Agent scratch files
.gemini/
.antigravity/
.agent-scratch/
scratch/

# Personal workout backups
gym-tracker-backup-*.json

# Local database dumps and archives
*.sqlite
*.sqlite3
*.dump
*.zip
*.tar.gz
